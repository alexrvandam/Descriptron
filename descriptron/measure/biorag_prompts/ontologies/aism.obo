relationship: RO:0000053 PATO:0002021 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has characteristic conical

[Term]
id: AISM:0000190
name: antennifer {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Antennifer: small cephalic process articulating with the antenna.\""}
def: "The cuticular protrusion of the head capsule thag is continuous with the antenniferal-scapal conjunctiva and adjacent to the cuticle of the scapus" [] {creation_date="2022-06-20", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000008 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! cuticular protrusion
relationship: BFO:0000050 AISM:0000019 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of head capsule
relationship: RO:0002150 AISM:0004007 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! continuous with antenniferal-scapal conjunctiva
relationship: RO:0002220 AISM:0000113 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! adjacent to scapus
property_value: IAO:0000232 "The cuticular protrusion (process, protuberace) that bears the cranial articular surface of the cranio-antennal articulation." xsd:string {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-02-08"}

[Term]
id: AISM:0000191
name: tentorium {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Tentorium: cephalic endoskeleton, usually composed of paired anterior, posterior and dorsal tentorial arms and a transverse tentorial bridge (corpotentorium).\""}
def: "The solid, paired, branching cuticular invagination of the head capsule that is attached to the antenna and the mouthparts via muscles." [] {creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000136 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! branching cuticular invagination
is_a: AISM:0000188 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! apodeme
is_a: UBERON:0000061 ! anatomical structure
relationship: BFO:0000050 AISM:0000019 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! part of head capsule
relationship: RO:0000053 PATO:0040024 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has characteristic bilaterally paired
property_value: IAO:0000232 "The paired apophysis that connects the posterior (ventral in prognathous head) and anterior (dorsal in prognathous head) walls of the head capsule and serves as site of isertion of atennal and mouthpart muscles." xsd:string {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-02-11"}

[Term]
id: AISM:0000192
name: tentorio-antennal muscle
def: "The insect cranial muscle that is attached to the tentorium and to the antenna." [] {creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000080 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! insect cranial muscle
relationship: RO:0002371 AISM:0000032 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! attached to antenna
relationship: RO:0002371 AISM:0000191 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! attached to tentorium

[Term]
id: AISM:0000193
name: cuticular pit {term:modified="2021-12-10"}
def: "The cuticular depression that corresponds to an apophysis." [] {creation_date="2021-02-12", x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"}
