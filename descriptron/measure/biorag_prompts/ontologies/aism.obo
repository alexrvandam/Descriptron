property_value: IAO:0000232 "Should coincide with 'exactly one' epithelial cell, but that violates OWL specs." xsd:string {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-26"}

[Term]
id: AISM:0000135
name: insect spiracle {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Spiracle: external opening of the tracheal system.\"", term:modified="2023-01-09", IAO:0000232="Modified 2023-01-09: specifying insect spiracle.\njgiron https://orcid.org/0000-0002-0851-6883"}
def: "The region of the cuticle that is continuous to the proximal region of a trachea and can be closed by muscles." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-04-21"}
is_a: AISM:0000174 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! insect region of cuticle
is_a: UBERON:0000061 ! anatomical structure
relationship: RO:0002371 UBERON:0014895 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! attached to somatic muscle, invertebrate

[Term]
id: AISM:0000136
name: branching cuticular invagination
def: "The cuticular ivagination that ramifies into umerous branches." [] {creation_date="2020-11-11", x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"}
is_a: AISM:0000006 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! cuticular invagination
relationship: RO:0000053 PATO:0000402 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has characteristic branched
property_value: IAO:0000232 "Branching cuticular invaginations porvide important models for branchig morphogenesis." xsd:string {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2020-11-11"}

[Term]
id: AISM:0000137
