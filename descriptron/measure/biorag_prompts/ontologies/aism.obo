id: AISM:0000165
name: mouthpart {creation_date="2020-11-17", IAO:0000232="Modified 2023-04-13: removed ‘cuticle of’ from label.\nstarasov https://orcid.org/0000-0001-5237-2330"}
def: "The cuticle of the appendage of the insect head that is encircled by the oral foraminal conjunctiva." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-04-21", term:modified="2021-12-10"}
is_a: AISM:0000029 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! insect appendage
relationship: AISM:0000079 AISM:0000099 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! encircled by oral foraminal conjunctiva
relationship: BFO:0000050 AISM:0000107 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of insect head
property_value: IAO:0000589 "cuticle of mouthpart" xsd:string {creation_date="2023-04-13"}

[Term]
id: AISM:0000166
name: propleuro-procoxal articulation
def: "The insect articulation between the propleuron and the procoxa." [] {creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000002 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! insect articulation

[Term]
id: AISM:0000167
name: articular surface
def: "The region of cuticle where two sclerites meet." [] {creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000174 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! insect region of cuticle
relationship: RO:0002220 AISM:0000003 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! adjacent to insect sclerite

[Term]
id: AISM:0000168
name: salivary sclerite
def: "The sclerite of the salivarium." [] {creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000003 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! insect sclerite
relationship: BFO:0000050 AISM:0000159 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! part of salivarium

[Term]
id: AISM:0000169
name: metanotum
def: "The notum or sclerite on the dorsal region of the metathorax that is posterior to the mesonotum, connected via the metanoto-metapleural conjuntiva to the dorsal margin of the metapleuron, that is not adjacent to the metacoxa, but attached to it by the metacoxal muscle." [] {x_1.1:contributor="jcgiron", creation_date="2021-04-21"}
is_a: AISM:0000003 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! insect sclerite
is_a: AISM:0004128 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! notum
is_a: UBERON:0000061 ! anatomical structure
relationship: BSPO:0000099 AISM:0000052 {x_1.1:contributor="jcgiron"} ! posterior to mesonotum
relationship: RO:0002150 AISM:0004221 {x_1.1:contributor="jcgiron"} ! continuous with metanoto-metapleural conjunctiva
relationship: RO:0002371 AISM:0000146 {x_1.1:contributor="jcgiron"} ! attached to metacoxal muscle

[Term]
id: AISM:0000170
name: metapectus
def: "The sclerite that is continuous with the basal metacoxal conjunctiva and the basal wing conjunctiva and contains the metafurca." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-04-21"}
is_a: AISM:0000003 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! insect sclerite
relationship: BFO:0000051 AISM:0000142 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has part metafurca
relationship: RO:0002150 AISM:0000104 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! continuous with basal metacoxal conjunctiva
relationship: RO:0002150 AISM:0004203 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! continuous with basal wing conjunctiva

[Term]
id: AISM:0000172
name: intertarsomeral conjunctiva
def: "The conjunctiva is encircled by a tarsomere that encircles another tarsomere." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-03-18"}
is_a: AISM:0000102 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! ring conjunctiva
relationship: AISM:0000078 AISM:0000074 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! encircles tarsomere
relationship: AISM:0000079 AISM:0000074 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! encircled by tarsomere

[Term]
id: AISM:0000173
name: basal coxal conjunctiva
def: "The conjunctiva that encircles the coxa and connects it to the ventral and lateral thoracic regions." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2020-11-17"}
is_a: AISM:0000102 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! ring conjunctiva
relationship: BFO:0000050 AISM:0000108 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of insect thorax
property_value: IAO:0000232 "These conjunctivae can be used as stable reference points in insects that poseess legs, and can be used to define sclerites on the lateral side of the thorax." xsd:string {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2020-11-17"}

[Term]
id: AISM:0000174
name: insect region of cuticle {IAO:0000232="Modified 2023-04-13: added insect to specify.\njgiron https://orcid.org/0000-0002-0851-6883"}
def: "The insect region of integument that is part of the chitin-based cuticle." [] {creation_date="2020-11-23", x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"}
is_a: BFO:0000004 ! independent continuant
relationship: BFO:0000050 UBERON:0001001 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! part of chitin-based cuticle
relationship: BFO:0000050 UBERON:6007284 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! part of insect region of integument
property_value: IAO:0000232 "The AISM focuses on anatomical structures that are part of the insect (chitinous) cuticle. These structures are acellular regions of the integument. Regions of the insect cuticle with different mechanical properties (i.e. increased and descresed flexinility, thickness, and elasticity) are continuous with each other (e.g. sclerites are continuous with conjunctivae or resilin rich regions are continuous with regions with less resilin content)." xsd:string {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2020-11-23"}

[Term]
id: AISM:0000177
name: pore canal {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Pore canals: thin perforations of the cuticle.\""}
def: "The orifice that is contained by the cuticle and connects the inside of the insect with the outside, is tubular, and whose diameter is smaller than 100 nm." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-02-04"}
is_a: UBERON:0000161 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! orifice
relationship: AISM:0000079 UBERON:0001002 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! encircled by cuticle
relationship: RO:0000053 PATO:0001873 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has characteristic cylindrical
relationship: RO:0002008 CL:0000066 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! coincident with epithelial cell
property_value: IAO:0000232 "Should coincide with 'exactly one' epithelial cell, but that violates OWL specs." xsd:string {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-26"}

[Term]
id: AISM:0000178
name: acantha {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Acanthae: hairs without sockets, one per hypodermal cell.\""}
def: "The solid cuticular protrusion that coincides with only one epidermal cell (smaller than the diameter of the epidermal cell)." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-02-04"}
is_a: AISM:0000028 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! solid cuticular protrusion
relationship: BFO:0000050 AISM:0000003 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! part of insect sclerite
relationship: RO:0002008 CL:0000362 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! coincident with epidermal cell
property_value: IAO:0000232 "Should coincide with 'exactly one' epithelial cell, but that violates OWL specs." xsd:string {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-26"}

[Term]
id: AISM:0000180
name: tergal carina {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2025-03-16"}
def: "The cuticular carina on a tergite (or notum)." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2025-03-16"}
