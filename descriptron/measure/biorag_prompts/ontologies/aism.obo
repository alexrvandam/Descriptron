[Term]
id: AISM:0004156
name: anapleural sulcus {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Anapleural suture (=paracoxal suture): suture horizontally delimiting dorsal and ventral parts of episternum and (partially) epimeron; sometimes anteriorly widened and membranous (=anapleural cleft).\""}
def: "The sulcus of the pleuron delimiting the dorsal region of the preepisternum and the ventral region of the anepisternum." [] {creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
synonym: "anapleural cleft" EXACT [] {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Anapleural suture (=paracoxal suture): suture horizontally delimiting dorsal and ventral parts of episternum and (partially) epimeron; sometimes anteriorly widened and membranous (=anapleural cleft).\""}
synonym: "paracoxal suture" EXACT [] {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Anapleural suture (=paracoxal suture): suture horizontally delimiting dorsal and ventral parts of episternum and (partially) epimeron; sometimes anteriorly widened and membranous (=anapleural cleft).\""}
is_a: AISM:0000162 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! cuticular sulcus
relationship: BFO:0000050 AISM:0004129 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of pleuron

[Term]
id: AISM:0004157
name: ecdysial line
def: "The anatomical line of weakness of the cuticle that allows molting and coincides with a suture." [] {creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
synonym: "molting line" EXACT [] {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Molting lines (frontal and coronal sutures [=epicranial lines or sutures])\""}
