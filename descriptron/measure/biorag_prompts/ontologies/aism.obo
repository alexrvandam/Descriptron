[Term]
id: AISM:0000047
name: distitarsus {AISM:0000171="Dashman, T. (1953) Terminology of the pretarsus. Annals of the Entomological Society of America 46, 56–62. https://doi.org/10.1093/aesa/46.1.56\n\n\"The distitarsus is the terminal, or most distal tarsal segment\"", IAO:0000232="Modified 2026-02-14: Updated to distitarsus to better reflect distal position on the leg.\n\njgiron https://orcid.org/0000-0002-0851-6883", AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Pretarsus: apical element of leg bearing ungues; distinct and cylindrical in entognathous hexapods, strongly reduced in Insecta.\"", IAO:0000232="Modified 2023-04-13: removed ‘cuticle of’ from label.\nstarasov https://orcid.org/0000-0001-5237-2330"}
def: "The cuticle of the appendage of the insect leg that is attached to the cuticle of tarsus by the tarso-distitarsal conjunctiva." [] {term:modified="2026-02-14", term:modified="2021-12-08", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-03-18"}
synonym: "pretarsus" EXACT [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
