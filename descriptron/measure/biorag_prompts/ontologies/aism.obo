relationship: RO:0002220 AISM:0004026 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to gena
relationship: RO:0002220 AISM:0004027 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to subgena

[Term]
id: AISM:0004033
name: hypostomal bridge {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Hypostomal bridge: partial closure of foramen occipitale, formed by ventromedially adjacent extensions of lateral head capsule.\"\n[posterior section of the subgenal ridge; p. 14]"}
def: "The lateral region of the head capsule that is adjacent to the foramen occipitale" [] {creation_date="2021-02-24", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
