[Term]
id: AISM:0004264
name: epistoma {creation_date="2022-02-21", AISM:0000171="Nichols, S. W. (1989) Torre-Bueno glossary of entomology. New York Entomological Society. 840 pp.\n\nhttps://ipmhouse.tamu.edu/files/2021/03/The-Torre-Bueno-Glossary-of-Entomology.pdf\n\n\"the oral margin or sclerite directly behind the labrum\""}
