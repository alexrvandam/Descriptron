[Typedef]
id: AISM:0000078
name: encircles {creation_date="2020-11-11", x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"}
def: "Structure x encircles structure y if both x and y are regions of the 2D structure z, or 2D cross-sections of a 3D object z, and the boundary of y on z is exclusively continuous with x." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-04-21"}
