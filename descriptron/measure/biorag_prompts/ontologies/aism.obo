xref: http://purl.obolibrary.org/obo/UBERON_0001054
is_a: AISM:0000136 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! branching cuticular invagination

[Term]
id: AISM:0000138
name: cuticular apophysis {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Apophysis: hollow cuticular invagination.\"", term:modified="2021-12-10"}
def: "The cuticular invagination that is hollow." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-04-21"}
is_a: AISM:0000006 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! cuticular invagination
is_a: AISM:0000188 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! apodeme
relationship: RO:0002008 AISM:0000193 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! coincident with cuticular pit
property_value: IAO:0000232 "The apophysis in HAO refers to an ivagination of the cuticle that is cylindrical as opposed to a ridge that is elongate. Beutel et al. 2014 differentiate apodemes from apophyses in that apodemes are solid and apophyses are hollow." xsd:string {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2020-11-11"}

[Term]
id: AISM:0000140
