[Term]
id: AISM:0004125
name: prothorax {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Prothorax: 1st thoracic segment, always completely wingless in extant hexapods.\"", IAO:0000232="Modified 2023-04-13: removed ‘cuticle of’ from label.\nstarasov https://orcid.org/0000-0001-5237-2330"}
def: "The region of the cuticle of the insect thorax that is anteriorly connected to the head by the neck membrane, posteriorly connected to the mesothorax by the prothorax-mesothorax conjunctiva, and contains the pronotum, the propeluron, the prosternum and one pair of legs." [] {creation_date="2021-03-14", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000174 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect region of cuticle
relationship: anteriorly_connected_to AISM:0000098 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! neck membrane
relationship: BFO:0000050 AISM:0000108 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of insect thorax
relationship: BFO:0000051 AISM:0000034 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part fore leg
relationship: BFO:0000051 AISM:0000059 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part pronotum
relationship: BFO:0000051 AISM:0000060 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part labial palpomere
relationship: BFO:0000051 AISM:0000061 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part prosternum
relationship: posteriorly_connected_to AISM:0000046 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! prothoracic-mesothoracic conjunctiva
property_value: IAO:0000589 "cuticle of prothorax" xsd:string {creation_date="2023-04-13"}

[Term]
id: AISM:0004126
name: mesothorax {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Mesothorax: 2nd thoracic segment, anterior segment of pterothorax; bearing forewings (groundplan of Pterygota).\"", IAO:0000232="Modified 2023-04-13: removed ‘cuticle of’ from label.\nstarasov https://orcid.org/0000-0001-5237-2330"}
def: "The region of the cuticle of the pterothorax that bears mid legs and fore wings." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0000174 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect region of cuticle
relationship: BFO:0000050 AISM:0004166 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of pterothorax
relationship: BFO:0000051 AISM:0000035 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part mid leg
relationship: BFO:0000051 AISM:0000037 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part fore wing
property_value: IAO:0000589 "cuticle of mesothorax" xsd:string {creation_date="2023-04-13"}

[Term]
id: AISM:0004127
name: metathorax {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Metathorax: 3rd thoracic segment, posterior segment of pterothorax; bearing hindwings (groundplan of Pterygota).\"", term:modified="Modified 2023-04-13: removed ‘cuticle of’ from label.\nstarasov https://orcid.org/0000-0001-5237-2330"}
def: "The region of the cuticle of the pterothorax that bears the hind legs and the hind wings." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
