name: tracheal gill {AISM:0000171="http://insecta.bio.spbu.ru/z/antidictionary/tergalii&gills.htm\n\n\"Paraspiracular tracheal gill. Paired abdominal appendage, whose trachea arises either directly from the spiracular trachea of the same abdominal segment, or from the nearest point of tracheae branching\"", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2023-02-05"}
