[Term]
id: AISM:0000087
name: labium {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"The labium or lower lip forms the posterior (orthognathous head) or ventral (prognathous head) closure of the preoral space and of the salivarium. It is homologous to the maxilla (2nd maxilla) of crustaceans, but its proximal\nparts form a structural unit without a recognizable median line or suture.\"", IAO:0000232="Modified 2023-04-13: removed ‘cuticle of’ from label.\nstarasov https://orcid.org/0000-0001-5237-2330"}
def: "The cuticle of the mouthpart appendage composed of the cuticle of submentum, which is attached by the submental-mental conjunctiva to the cuticle of mentum, which is attached by the mental-premental conjunctiva to the cuticle of prementum, which is attached to the cuticle of palpiger by the premental-palpigeral conjunctiva, the cuticle of paraglossa by the premental-paraglossal conjunctiva, and the cuticle of glossa by the premental-glossal conjunctiva; the cuticle of palpiger is attached by the palpigero-palpal conjunctiva to the cuticle of labial palpus." [] {term:modified="2021-12-08", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-02-19"}
is_a: AISM:0000165 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! mouthpart
relationship: BFO:0000051 AISM:0000024 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part labial palpus
relationship: BFO:0000051 AISM:0000048 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part ligula
relationship: BFO:0000051 AISM:0000057 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part prementum
relationship: BFO:0000051 AISM:0004002 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part mental-premental conjunctiva
relationship: BFO:0000051 AISM:0004004 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part insect mentum
relationship: BFO:0000051 AISM:0004005 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part submentum
relationship: BFO:0000051 AISM:0004006 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part palpiger
relationship: BFO:0000051 AISM:0004013 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part submental-mental conjunctiva
relationship: BFO:0000051 AISM:0004014 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part premental-palpigeral conjunctiva
relationship: BFO:0000051 AISM:0004015 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part premental-paraglossal conjunctiva
relationship: BFO:0000051 AISM:0004016 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part premental-glossal conjunctiva
relationship: BFO:0000051 AISM:0004017 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part palpigero-palpal conjunctiva
property_value: IAO:0000589 "cuticle of labium" xsd:string {creation_date="2023-04-13"}

[Term]
id: AISM:0000088
name: eye cuticle {creation_date="2020-11-11"}
def: "The elastic cuticle of the head capsule that is transparent and covers the eye." [] {creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
