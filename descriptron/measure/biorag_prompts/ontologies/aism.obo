relationship: BFO:0000051 AISM:0000074 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part tarsomere
relationship: RO:0000053 PATO:0040024 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has characteristic bilaterally paired
property_value: IAO:0000589 "cuticle of tarsus" xsd:string {creation_date="2023-04-13"}

