[Term]
id: AISM:0004022
name: circumocular ridge {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Circumocular ridge: internal ridge enclosing compound eye.\""}
def: "The ridge of the head capsule surrounding the eye cuticle." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-02-19"}
is_a: AISM:0000158 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! cuticular ridge
