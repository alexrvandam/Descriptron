relationship: RO:0002150 AISM:0004187 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! continuous with tarso-distitarsal conjunctiva
property_value: IAO:0000589 "cuticle of distitarsus" xsd:string {creation_date="2023-04-13"}

[Term]
id: AISM:0000048
name: ligula {AISM:0000171="Snodgrass RE (1993) Principles of Insect Morphology. Cornell University Press, 768 pp.\n\nhttps://www.jstor.org/stable/10.7591/j.ctv1nhm1j\n\n\"Ligula - The terminal lobes of the labium collectively, or a terminal part of the labium formed by the union of the lobes.\"", IAO:0000232="Modified 2023-04-13: removed ‘cuticle of’ from label.\nstarasov https://orcid.org/0000-0001-5237-2330"}
def: "The cuticle of the appendage of the cuticle of labium composed of the cuticle of glossa and cuticle of paraglossa jointly." [] {term:modified="2021-12-08", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-02-19"}
