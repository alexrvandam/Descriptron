[Term]
id: AISM:0000200
name: gonocoxa IX {IAO:0000232="Modified 2023-04-13: removed ‘cuticle of’ from label.\nstarasov https://orcid.org/0000-0001-5237-2330"}
def: "The paired sclerite of the postabdomen that is attached to the abdominal tergite IX by the abdominal tergite IX-gonocoxa IX conjunctiva and is articulated with abdominal tergite IX." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-03-19"}
synonym: "second coxopodite" EXACT [] {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Coxopodite (=valvifer, gonocoxa, gonocoxite): short basal piece of ovipositor elements of female genital segments VIII and IX.\""}
synonym: "second gonocoxite" EXACT [] {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Coxopodite (=valvifer, gonocoxa, gonocoxite): short basal piece of ovipositor elements of female genital segments VIII and IX.\""}
synonym: "second valvifer" EXACT [] {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Coxopodite (=valvifer, gonocoxa, gonocoxite): short basal piece of ovipositor elements of female genital segments VIII and IX.\""}
is_a: AISM:0004301 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! gonocoxite
relationship: RO:0002150 AISM:0000201 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! continuous with abdominal tergite IX-gonocoxa IX conjunctiva
property_value: IAO:0000589 "cuticle of gonocoxa IX" xsd:string {creation_date="2023-04-13"}

