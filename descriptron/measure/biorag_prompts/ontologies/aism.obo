[Term]
id: AISM:0000032
name: antenna {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter. \n\nhttps://doi.org/10.1515/9783110264043\n\n\"Antenna: head appendage of segment 2, innervated by deutocerebrum; in Insecta composed of scapus, pedicellus and flagellum; primarily multisegmented and filiform.\"", IAO:0000232="Modified 2023-04-13: removed ‘cuticle of’ from label.\nstarasov https://orcid.org/0000-0001-5237-2330"}
def: "The cuticle of the appendage of the head capsule that is connected by the  antenniferal-scapal conjunctiva to the cuticle of the scapus, which is connected by the scapal-pedicellar conjunctiva to the cuticle of the pedicellus; the cuticle of the pedicellus is connected by the pedicellar-first flagellomeral conjunctiva to the cuticle of the first flagellomere; the cuticle of the first flagellomere is connected by interflagellomeral conjunctiva to the next cuticle of flagellomere. Further cuticle of flagellomeres are connected to each other by interflagellomeral conjunctiva." [] {term:modified="2021-12-08", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-02-19"}
is_a: AISM:0000029 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! insect appendage
relationship: AISM:0000079 AISM:0004007 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! encircled by antenniferal-scapal conjunctiva
relationship: BFO:0000050 UBERON:6003007 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of insect adult head
relationship: BFO:0000051 AISM:0000113 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part scapus
relationship: BFO:0000051 AISM:0000114 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part scapal-pedicellar conjunctiva
relationship: BFO:0000051 AISM:0000115 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part pedicellus
relationship: BFO:0000051 AISM:0000117 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part flagellomere 1
relationship: BFO:0000051 AISM:0000118 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part pedicellar-first flagellomeral conjunctiva
relationship: BFO:0000051 AISM:0004008 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part interflagellomeral conjunctiva
relationship: RO:0000053 PATO:0040024 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has characteristic bilaterally paired
property_value: IAO:0000589 "cuticle of antenna" xsd:string {creation_date="2023-04-13"}

[Term]
id: AISM:0000033
name: insect wing {AISM:0000171="Nichols, S. W. (1989) Torre-Bueno glossary of entomology. New York Entomological Society. 840 pp.\n\nhttps://ipmhouse.tamu.edu/files/2021/03/The-Torre-Bueno-Glossary-of-Entomology.pdf\n\n\"in adult insects or subimago of Ephemeroptera, paired mambranous appendages, supported by veins, located on the mesothorax or metathorax, functioning in flight\"", IAO:0000232="Modified 2023-04-13: removed ‘cuticle of’ from label.\nstarasov https://orcid.org/0000-0001-5237-2330"}
def: "The cuticle of the flat, paired appendage on the dorso-lateral region of the pterothorax." [] {term:modified="2021-12-08", creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
