[Term]
id: AISM:0000181
name: tibial spur {creation_date="2025-03-17", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
def: "The cuticular spur that is continuous with the distal margin of the tibia." [] {creation_date="2025-03-17", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000040 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2025-03-17"} ! cuticular spur

[Term]
id: AISM:0000185
name: sensillum chaeticum {IAO:0000232="Modified 2023-01-11: moved under cuticular sensilla; added has part cuticular seta.\njgiron https://orcid.org/0000-0002-0851-6883", AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Sensillum chaeticum: shorter than sensillum trichodeum, thick-walled.\""}
def: "The hairlike seta that is short and thick walled." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-02-08"}
is_a: AISM:0004304 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! cuticular sensilla
relationship: BFO:0000051 AISM:0000039 {IAO:0000232="Modified 2023-01-11: added has part cuticular seta.\njgiron https://orcid.org/0000-0002-0851-6883", x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has part cuticular seta
relationship: RO:0000053 PATO:0002228 {IAO:0000232="Modified 2023-01-11: added has part cuticular seta.\njgiron https://orcid.org/0000-0002-0851-6883", x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has characteristic acuminate

[Term]
id: AISM:0000186
name: sensillum trichodeum {IAO:0000232="Modified 2023-01-11: moved under cuticular sensilla; added has part cuticular seta.\njgiron https://orcid.org/0000-0002-0851-6883", AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Sensillum trichodeum: hair-like sensilla, seta associated with sensory cell.\""}
def: "The cuticular seta that is elongated and acuminate." [] {creation_date="2022-06-20", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0004304 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! cuticular sensilla
relationship: BFO:0000051 AISM:0000039 {IAO:0000232="Modified 2023-01-11: added has part cuticular seta.\njgiron https://orcid.org/0000-0002-0851-6883", x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has part cuticular seta
relationship: BFO:0000051 AISM:0000039 {IAO:0000232="Modified 2023-01-11: added has part cuticular seta.\njgiron https://orcid.org/0000-0002-0851-6883", x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has part cuticular seta
relationship: RO:0000053 PATO:0001154 {IAO:0000232="Modified 2023-01-11: added has part cuticular seta.\njgiron https://orcid.org/0000-0002-0851-6883", x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has characteristic elongated
relationship: RO:0000053 PATO:0002228 {IAO:0000232="Modified 2023-01-11: added has part cuticular seta.\njgiron https://orcid.org/0000-0002-0851-6883", x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has characteristic acuminate
property_value: IAO:0000232 "Hairlike seta that is long." xsd:string {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-02-08"}

[Term]
id: AISM:0000187
name: sensillum coeloconicum {IAO:0000232="Modified 2023-01-11: moved under cuticular sensilla; added has part cuticular seta.\njgiron https://orcid.org/0000-0002-0851-6883", AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Sensillum coeloconicum: sensillum with modified seta in a cavity, with narrowed external opening of surrounding cuticle.\""}
def: "Seta that is located in the middle of a depression with narrowed external opening." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-02-08"}
is_a: AISM:0004304 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! cuticular sensilla

[Term]
id: AISM:0000188
name: apodeme {AISM:0000171="Klass K-D (2001) The female abdomen of the viviparous earwig Hemimerus vosseleri (Insecta: Dermaptera: Hemimeridae), with a discussion of the postgenital abdomen of Insecta. Zoological Journal of the Linnean Society 131: 251–307. \n\nhttps://doi.org/10.1111/j.1096-3642.2001.tb02239.x \n\n\"tendon is used herein to designate sclerotized internal cuticular projections\"", AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter. \n\nhttps://doi.org/10.1515/9783110264043\n\n\"Apodeme: solid cuticular invagination serving as muscle insertion area.\""}
def: "The solid cuticular invagination of a sclerite." [] {creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000000 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! cuticular internal depression
relationship: BFO:0000050 AISM:0000003 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! part of insect sclerite
relationship: RO:0000053 PATO:0001873 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! has characteristic cylindrical

[Term]
id: AISM:0000189
name: sensillum basiconicum {IAO:0000232="Modified 2023-01-11: moved under cuticular sensilla; added has part cuticular seta.\njgiron https://orcid.org/0000-0002-0851-6883", AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Sensillum basiconicum: sensillum with rounded, conical seta.\""}
def: "The seta that is conical." [] {creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0004304 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! cuticular sensilla
