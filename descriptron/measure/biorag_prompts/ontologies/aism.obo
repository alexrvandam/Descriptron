[Term]
id: AISM:0004302
name: insect mouth {AISM:0000171="Snodgrass RE (1993) Principles of Insect Morphology. Cornell University Press, 768 pp.\n\nhttps://www.jstor.org/stable/10.7591/j.ctv1nhm1j\n\n\"Mouth. The external opening of the stomodaeum, situated in the ventral wall of the head between the labrum and the hypopharynx.\"", creation_date="2023-01-09", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
def: "The mouth that is surrounded by insect mandibles, labium, and labrum and is anterior to the hypopharynx." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883 2023-03-30", creation_date="2024-01-25"}
synonym: "preoral cavity" EXACT [] {creation_date="2023-01-09", AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"The preoral cavity is the space enclosed between the labrum and labium and the paired mandibles and maxillae\"", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: UBERON:0000165 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2023-01-09"} ! mouth
