[Term]
id: AISM:0004040
name: alaforamen {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter. \n\nhttps://doi.org/10.1515/9783110264043\n\n\"Alaforamen: part of foramen occipitale above tentorial bridge; passage of oesophagus and tracheal stems.\""}
def: "The arthropod foramen that is part of the foramen occipitale and is located above the tentorial bridge." [] {creation_date="2021-04-03", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000197 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! arthropod foramen
