[Term]
id: AISM:0004025
name: vertex {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Vertex: posterodorsal part of head capsule, usually medially divided by ecdysial line (coronal suture).\""}
def: "The dorsal region of the head capsule that surrounds the coronal suture, and is connected laterally to the genae." [] {creation_date="2021-02-24", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000174 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect region of cuticle
relationship: AISM:0000078 AISM:0004030 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! encircles coronal suture

[Term]
id: AISM:0004026
name: gena {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Gena: lateral region of head capsule; not separated from vertex by a ridge or suture.\""}
def: "The lateral region of the head capsule, connected dorsally to the lateral regions of the vertex." [] {creation_date="2021-02-24", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000174 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect region of cuticle

[Term]
id: AISM:0004027
name: subgena {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Subgena: narrow lateral region of head capsule, above external side of mandibular base, usually separated from gena by subgenal ridge.\""}
def: "The lateral region of the head capsule that connects dorsally to the ventral side of the gena and ventrally to the mandible." [] {creation_date="2021-02-24", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000174 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect region of cuticle
relationship: RO:0002220 AISM:0000043 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to insect mandible

[Term]
id: AISM:0004028
name: cuticular suture {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Suture: ecdysial suture, zone of weakness.\"", term:modified="2021-12-10"}
def: "The region of the cuticle of the head capsule that coincides with an ecdysial line." [] {creation_date="2021-04-21", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000174 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect region of cuticle
relationship: BFO:0000050 AISM:0000019 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of head capsule
relationship: RO:0002008 AISM:0004157 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! coincident with ecdysial line

[Term]
id: AISM:0004029
name: frontal suture {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Frontal suture: paired ecdysial sutures enclosing frons; anterior parts of epicranial suture.\""}
def: "The cuticular suture that surrounds the frons and is connected to the coronal suture." [] {creation_date="2021-04-03", term:modified="2021-12-10", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0004028 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! cuticular suture
relationship: AISM:0000078 AISM:0004020 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! encircles frons
relationship: RO:0000053 PATO:0040024 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has characteristic bilaterally paired
relationship: RO:0002150 AISM:0004030 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! continuous with coronal suture

[Term]
id: AISM:0004030
name: coronal suture {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Coronal suture: unpaired median ecdysial sutures dividing vertex; anteriorly continuous with frontal sutures.\""}
def: "The longitudinal cuticular suture that is on the vertex and is connected to the frontal suture." [] {creation_date="2021-04-03", term:modified="2021-12-10", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0004028 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! cuticular suture
relationship: AISM:0000079 AISM:0004025 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! encircled by vertex
relationship: parallel_to BSPO:0000013 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! anterior-posterior axis
relationship: RO:0002150 AISM:0004029 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! continuous with frontal suture

[Term]
id: AISM:0004031
name: pleurostomal ridge {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n[Pleurostomal ridge: anterior section of the subgenal ridge above the mandibular base. (p. 14)]"}
def: "The ridge of the head capsule comprising the posterior region of the subgenal ridge." [] {creation_date="2021-02-24", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000158 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! cuticular ridge

[Term]
id: AISM:0004032
name: subgenal ridge {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Subgenal ridge: strengthening ridge separating gena from subgena.\""}
def: "The ridge of the head capsule that separates the gena and the subgena." [] {creation_date="2021-02-24", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000158 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! cuticular ridge
