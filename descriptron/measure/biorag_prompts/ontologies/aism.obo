relationship: BFO:0000050 AISM:0000019 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of head capsule

[Term]
id: AISM:0004023
name: foramen occipitale {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Foramen occipitale (=foramen magnum): posterior opening of head capsule; divided by tentorial bridge into alaforamen and neuroforamen.\""}
def: "The foramen of the head capsule that connects with the neck membrane and is divided by the tentorial bridge into alaforamen and neuroforamen." [] {creation_date="2021-02-24", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
