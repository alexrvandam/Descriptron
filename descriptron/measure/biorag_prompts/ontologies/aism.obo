relationship: RO:0002150 UBERON:0014895 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! continuous with somatic muscle, invertebrate
property_value: IAO:0000232 "The usually cylindircal evagination of the cuticle that is resilin rich and is continuous with somatic muscles." xsd:string {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2020-11-11"}

[Term]
id: AISM:0000091
name: insect trachea {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Trachea: tube-shaped elements of the tracheal system.\"", IAO:0000232="Modified 2023-01-09 to specify insect trachea.\njgiron https://orcid.org/0000-0002-0851-6883"}
def: "The branching invagination of elastic cuticle that is cylindrical and contains taenidia." [] {creation_date="2020-11-11", x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"}
