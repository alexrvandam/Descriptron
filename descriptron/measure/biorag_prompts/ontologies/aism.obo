relationship: RO:0002150 AISM:0000145 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! continuous with procoxal muscle
relationship: RO:0002220 AISM:0000059 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to pronotum
relationship: RO:0002220 AISM:0000061 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to prosternum

[Term]
id: AISM:0004143
name: postnotum {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Postnotum: smaller posterior part of tergum, forming internal intersegmental phragma; attachment area for dorsal indirect flight muscles.\""}
def: "The sclerite of the notum that is attached to the posterior margin of the scutellum." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0000003 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect sclerite
relationship: BFO:0000050 AISM:0004128 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of notum

[Term]
