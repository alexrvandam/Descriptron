property_value: IAO:0000589 "cuticle of metathorax" xsd:string {creation_date="2023-04-13"}

[Term]
id: AISM:0004128
name: notum {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Notum: larger anterior part of tergum, composed of presutum, scutum and scutellum.\""}
def: "The dorsal region of the cuticle of the insect thorax that is attached to the dorsal margin of the pleuron." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
synonym: "tergum" EXACT [] {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Tergum: dorsal wall of a thoracic (or abdominal) segment.\""}
is_a: AISM:0000174 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect region of cuticle

[Term]
id: AISM:0004129
name: pleuron {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Pleuron: lateral wall of thoracic segments, almost always divided by pleural ridge into anterior episternum and posterior epimeron.\""}
def: "The region of cuticle on the lateral region of the insect thorax that is attached to the notum and the sternum and is attached to the coxae by skeletal muscle tissue and the basal coxal conjunctiva." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0000174 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect region of cuticle
is_a: UBERON:0000061 ! anatomical structure
relationship: RO:0002150 AISM:0000173 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! continuous with basal coxal conjunctiva
relationship: RO:0002220 AISM:0004128 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to notum
relationship: RO:0002220 AISM:0004130 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to sternum

[Term]
id: AISM:0004130
name: sternum {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Sternum: ventral wall of thoracic (or abdominal) segment, usually divided into presternum, basisternum, furcasternum and spinasternum in unspecialized hexapods; largely or completely invaginated in Holometabola (cryptosterny).\""}
def: "The ventral region of the cuticle of the insect thorax that is attached to the ventral margin of the pleuron." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0000174 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect region of cuticle

[Term]
id: AISM:0004131
name: pleurite {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Pleurite: sclerotized element of pleuron.\""}
def: "The sclerite that is part of the pleuron." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0000003 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect sclerite
relationship: BFO:0000050 AISM:0004129 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of pleuron

[Term]
id: AISM:0004132
name: pleural ridge {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Pleural ridge: internal ridge, corresponding to externally visible pleural “suture”; separates episternum and epimeron; anterodorsally forming the pleural wing process and posteroventrally the pleuro-coxal joint.\""}
def: "The ridge between the epimeron and the episternum in either the mesothorax or the metathorax." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0000158 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! cuticular ridge
relationship: RO:0002150 AISM:0004133 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! continuous with episternum
relationship: RO:0002150 AISM:0004134 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! continuous with epimeron

[Term]
id: AISM:0004133
name: episternum {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Episternum: part of pleuron anterior to pleural ridge.\""}
def: "The sclerite of the insect thorax that is part of the pleuron and anterior to the pleural ridge and attached to the anterior margin of the epimeron." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0000003 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect sclerite
relationship: BFO:0000050 AISM:0004129 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of pleuron
relationship: BSPO:0000096 AISM:0004132 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! anterior to pleural ridge
relationship: RO:0000053 PATO:0040024 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has characteristic bilaterally paired

[Term]
id: AISM:0004134
name: epimeron {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Epimeron: part of pleuron posterior to pleural ridge.\""}
def: "The sclerite of the insect thorax that is part of the pleuron and posterior to the pleural ridge and attached to the posterior margin of the episternum." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0000003 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect sclerite
relationship: BFO:0000050 AISM:0004129 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of pleuron
relationship: BSPO:0000099 AISM:0004132 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! posterior to pleural ridge
relationship: RO:0000053 PATO:0040024 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has characteristic bilaterally paired

[Term]
id: AISM:0004135
name: trochantin {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Trochantin: small triangular or sickle-shaped ventral pleural sclerite; anteriorly articulating with coxa (trochantino-coxal joint).\""}
def: "The sclerite that is located on the ventro-lateral region of the insect thorax and is attached to a coxa." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0000003 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect sclerite
relationship: AISM:0000079 AISM:0000173 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! encircled by basal coxal conjunctiva
relationship: RO:0002220 AISM:0000077 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to coxa

[Term]
id: AISM:0004136
name: presternum {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Presternum: anteriormost part of sternum.\""}
def: "The part of the sternum that is attached to the anterior margin of the basisternum." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0004130 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! sternum

[Term]
id: AISM:0004137
name: basisternum {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Basisternum: main part of sternum, between presternum and furcasternum.\""}
def: "The part of the sternum that is attached to the posterior margin of the presternum and to the anterior margin of the furcasternum." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0004130 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! sternum

[Term]
id: AISM:0004138
name: furcasternum {x_1.1:contributor="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Furcasternum (=sternellum): sternal element posterior to basisternum, area of origin of furca.\""}
def: "The part of the sternum that is attached to the posterior margin of the basisternum and to the anterior margin of the spinasternum." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
synonym: "sternellum" EXACT [] {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Furcasternum (=sternellum): sternal element posterior to basisternum, area of origin of furca.\""}
is_a: AISM:0004130 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! sternum

[Term]
id: AISM:0004139
name: spinasternum {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Spinasternum: small posterior sternal element, determining the posterior segmental border; area of origin of spina.\""}
def: "The part of the sternum that is attached to the posterior margin of the furcasternum and to the anterior margin of the poststernite." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0004130 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! sternum

[Term]
id: AISM:0004140
name: poststernite {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Poststernite: posteriormost sternal element.\""}
def: "The part of the sternum that is attached to the posterior margin of the spinasternum." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
is_a: AISM:0004130 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! sternum

[Term]
id: AISM:0004141
name: cervical sclerite {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Cervical sclerite: articulatory sclerite embedded in the cervical membrane.\""}
def: "The sclerite that is surrounded by the neck membrane." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-05"}
