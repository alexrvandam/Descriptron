relationship: BFO:0000051 AISM:0004055 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part preabdomen
relationship: BFO:0000051 AISM:0004056 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! has part postabdomen
relationship: BSPO:0000099 AISM:0000108 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! posterior to insect thorax
property_value: IAO:0000232 "The thorax is defined based on local properties (e.g. attachment sites of coxal muscles) and therefore we can reference this class for the definition of the abdomen." xsd:string {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2020-11-11"}
