[Term]
id: AISM:0000134
name: cuticular exocrine gland duct {creation_date="2020-11-11", term:modified="2021-12-10"}
def: "The branching cuticular invagination that corresponds to the invagination of the membrane of a single cell and does not contain taenidia." [] {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075", creation_date="2021-04-21"}
is_a: AISM:0000136 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! branching cuticular invagination
