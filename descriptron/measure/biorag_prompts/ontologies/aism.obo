relationship: BSPO:0000096 AISM:0000022 {x_1.1:contributor="imiko https://orcid.org/0000-0003-2938-9075"} ! anterior to first axillary sclerite
relationship: RO:0002220 AISM:0004154 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to anepisternum

[Term]
id: AISM:0004153
name: subalare {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Subalare: sclerite associated with wing base, usually embedded in membrane between tergum and pleuron; attachment site of direct flight muscles.\""}
def: "The epipleurite that is adjacent to the notum, is attached to the coxa via muscle, is surrounded by the noto-pleural conjunctiva, and is posterior to the first axillary sclerite." [] {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-04-09"}
