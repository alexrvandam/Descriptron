[Term]
id: AISM:0004261
name: empodium {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Empodium: a median process between the claws and pulvilli (if present). It arises from the distal end of the unguitractor plate, is spine-shaped or lobe-like and is sometimes similar in form to the pulvilli (“empodial pulvillus”).\" p. 43.", AISM:0000171="Nichols, S. W. (1989) Torre-Bueno glossary of entomology. New York Entomological Society. 840 pp.\n\nhttps://ipmhouse.tamu.edu/files/2021/03/The-Torre-Bueno-Glossary-of-Entomology.pdf\n\n\"a spine- or lobelike process of the unguitractor\"", IAO:0000232="Modified 2023-04-13: removed ‘cuticle of’ from label.\nstarasov https://orcid.org/0000-0001-5237-2330"}
def: "The cuticular protrusion that is part of the distitarsus, ventral to the distitarsal claws and medial to the pulvilli (if present)." [] {IAO:0000232="Modified 2026-02-14: Updated to distitarsus.\njgiron https://orcid.org/0000-0002-0851-6883", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2021-11-19", IAO:0000232="Modified 2023-01-11: added medial to pulvilli.\njgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000008 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! cuticular protrusion
relationship: AISM:0000012 AISM:0004308 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883", creation_date="2023-01-11"} ! medial_to pulvillus
relationship: BFO:0000050 AISM:0000047 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! part of distitarsus
relationship: BSPO:0000102 AISM:0004260 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! ventral to distitarsal claw
property_value: IAO:0000589 "cuticle of empodium" xsd:string {creation_date="2023-04-13"}

