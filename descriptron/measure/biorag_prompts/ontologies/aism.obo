id: AISM:0004050
name: anteclypeus {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Anteclypeus: transparent distal part of clypeus.\""}
def: "The region of the cuticle comprising the anterior region of the clypeus." [] {creation_date="2021-02-24", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
is_a: AISM:0000174 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! insect region of cuticle

[Term]
id: AISM:0004051
name: clypeolabrum {AISM:0000171="Beutel RG, Friedrich F, Yang X-K, Ge S-Q (2014) Insect Morphology and Phylogeny Insect morphology and phylogeny: a textbook for students of entomology. De Gruyter.\n\nhttps://doi.org/10.1515/9783110264043\n\n\"Clypeolabrum: area comprising the fused clypeus and labrum.\""}
def: "The region of the cuticle that is composed of the clypeus and the labrum." [] {creation_date="2021-02-24", x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"}
