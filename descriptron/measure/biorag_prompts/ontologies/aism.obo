relationship: RO:0002150 AISM:0004009 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! continuous with stipito-lacinial conjunctiva
relationship: RO:0002150 AISM:0004010 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! continuous with stipito-palpiferal conjunctiva
relationship: RO:0002150 AISM:0004011 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! continuous with stipito-galeal conjunctiva
relationship: RO:0002220 AISM:0000018 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to cardo
relationship: RO:0002220 AISM:0000023 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to galea
relationship: RO:0002220 AISM:0000026 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to lacinia
relationship: RO:0002220 AISM:0004001 {x_1.1:contributor="jgiron https://orcid.org/0000-0002-0851-6883"} ! adjacent to palpifer
